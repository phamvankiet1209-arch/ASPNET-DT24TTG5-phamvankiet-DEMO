@model HotelBookingManagementSystem.ViewComponents.NotificationBellModel
<div class="dropdown">
    <a class="btn btn-light rounded-circle position-relative" data-bs-toggle="dropdown" href="#">
        <i class="fa-regular fa-bell"></i>
        @if (Model.Unread > 0)
        {
            <span class="notif-dot"></span>
        }
    </a>
    <div class="dropdown-menu dropdown-menu-end p-0" style="width:320px">
        <div class="p-3 border-bottom fw-semibold">Thông báo (@Model.Unread)</div>
        @if (!Model.Items.Any())
        {
            <div class="p-3 text-muted">Chưa có thông báo</div>
        }
        @foreach (var n in Model.Items)
        {
            <div class="px-3 py-2 border-bottom @(n.IsRead ? "" : "bg-light")">
                <div class="fw-semibold small">@n.Title</div>
                <div class="small text-muted">@n.Message</div>
            </div>
        }
        <a class="dropdown-item text-center" asp-controller="Notification" asp-action="Index">Xem tất cả</a>
    </div>
</div>
