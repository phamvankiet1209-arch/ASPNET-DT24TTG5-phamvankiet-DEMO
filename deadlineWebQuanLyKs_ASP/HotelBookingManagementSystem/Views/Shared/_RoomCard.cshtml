@model Room
<div class="card-lux fill">
    <div class="media">
        <img src="@(string.IsNullOrWhiteSpace(Model.Thumbnail) ? "/images/rooms/room-01.jpg" : Model.Thumbnail)" alt="@Model.Name" />
        @if (Model.HasDiscount)
        {
            <span class="badge badge-accent position-absolute top-0 start-0 m-3">Ưu đãi biển</span>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            <button type="button" class="btn btn-light rounded-circle position-absolute top-0 end-0 m-3 js-fav" data-id="@Model.RoomId"><i class="fa-regular fa-heart"></i></button>
        }
    </div>
    <div class="p-3 p-lg-4">
        <div class="small text-muted">@Model.Hotel?.Name · @Model.Hotel?.City</div>
        <h5 class="mt-1 mb-2">@Model.Name</h5>
        <div class="stars small mb-2">
            <i class="fa-solid fa-star"></i> @(Model.AverageRating > 0 ? Model.AverageRating.ToString("0.0") : "Mới")
            <span class="text-muted">(@Model.ReviewCount đánh giá)</span>
        </div>
        <div class="d-flex flex-wrap gap-1 mb-3">
            @if (Model.HasWifi) { <span class="amenity-chip"><i class="fa-solid fa-wifi"></i> Wi-Fi</span> }
            @if (Model.BreakfastIncluded) { <span class="amenity-chip">Bữa sáng</span> }
            @if (Model.HasBalcony) { <span class="amenity-chip">Ban công</span> }
        </div>
        <div class="d-flex justify-content-between align-items-end gap-2">
            <div>
                @if (Model.HasDiscount)
                {
                    <div class="price-old">@CurrencyHelper.ToVnd(Model.PricePerNight)</div>
                }
                <div class="price">@CurrencyHelper.ToVnd(Model.DisplayPrice) <small class="text-muted">/đêm</small></div>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-primary btn-sm btn-rounded" asp-controller="Room" asp-action="Details" asp-route-id="@Model.RoomId">Chi tiết</a>
                <a class="btn btn-primary btn-sm btn-rounded" asp-controller="Booking" asp-action="Create" asp-route-roomId="@Model.RoomId">Đặt ngay</a>
            </div>
        </div>
    </div>
</div>
