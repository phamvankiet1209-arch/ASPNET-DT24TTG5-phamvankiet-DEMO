@model ErrorViewModel
@{ ViewData["Title"] = Model.Title ?? "Lỗi"; }
<div class="container py-5">
    <div class="card-lux p-5 text-center">
        <div class="display-4 fw-bold text-primary mb-3">@Model.StatusCode</div>
        <h2>@Model.Title</h2>
        <p class="muted">@Model.Message</p>
        @if (Model.ShowRequestId) { <p class="small text-muted">Mã yêu cầu: @Model.RequestId</p> }
        <a class="btn btn-primary btn-rounded" asp-controller="Home" asp-action="Index">Về trang chủ</a>
    </div>
</div>
