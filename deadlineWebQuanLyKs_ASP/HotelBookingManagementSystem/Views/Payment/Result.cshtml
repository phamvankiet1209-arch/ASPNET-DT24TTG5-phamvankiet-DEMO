@model Payment
@{ ViewData["Title"] = "Kết quả thanh toán"; var ok = (bool)ViewBag.Success; }
<div class="container py-5">
    <div class="card-lux p-5 text-center">
        <i class="fa-solid @(ok ? "fa-circle-check text-success" : "fa-circle-xmark text-danger") fa-3x mb-3"></i>
        <h2>@(ok ? "Thanh toán thành công" : "Thanh toán chưa hoàn tất")</h2>
        <p>Mã GD: @Model.TransactionCode · Đặt phòng @Model.Booking.BookingCode</p>
        <p>Số tiền: @CurrencyHelper.ToVnd(Model.Amount)</p>
        <a class="btn btn-primary" asp-controller="Booking" asp-action="Details" asp-route-id="@Model.BookingId">Xem đặt phòng</a>
    </div>
</div>
