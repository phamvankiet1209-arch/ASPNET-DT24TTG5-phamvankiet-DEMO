@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Quên mật khẩu"; }
<div class="container py-5">
    <form asp-action="ForgotPassword" method="post" class="card-lux p-4 mx-auto" style="max-width:520px">
        @Html.AntiForgeryToken()
        <h3>Quên mật khẩu</h3>
        <p class="text-muted">Nhập email để nhận liên kết đặt lại (demo, chuyển thẳng tới form reset).</p>
        <div class="mb-3"><label class="form-label">Email</label><input asp-for="Email" class="form-control" /></div>
        <button class="btn btn-primary">Tiếp tục</button>
    </form>
</div>
