@model LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập - StayLux</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Manrope:wght@400;600;700&display=swap" rel="stylesheet" />
</head>
<body class="auth-panel">
    <form asp-action="Login" method="post" class="auth-card">
        @Html.AntiForgeryToken()
        <h2 class="mb-1">Xin chào trở lại</h2>
        <p class="text-muted">Đăng nhập để đặt phòng và quản lý kỳ nghỉ.</p>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="mb-3"><label class="form-label">Email</label><input asp-for="Email" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">Mật khẩu</label><input asp-for="Password" class="form-control" /></div>
        <div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input" /><label class="form-check-label">Ghi nhớ đăng nhập</label></div>
        <button class="btn btn-primary w-100 mb-3">Đăng nhập</button>
        <div class="d-flex justify-content-between small">
            <a asp-action="Register">Tạo tài khoản</a>
            <a asp-action="ForgotPassword">Quên mật khẩu?</a>
        </div>
        <hr />
        <div class="small text-muted">Demo: admin@hotel.com / Admin@123 · customer@hotel.com / Customer@123</div>
    </form>
</body>
</html>
