@model ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<div class="container py-5">
    <form asp-action="ChangePassword" method="post" class="card-lux p-4 mx-auto" style="max-width:520px">
        @Html.AntiForgeryToken()
        <h3>Đổi mật khẩu</h3>
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3"><label class="form-label">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">Mật khẩu mới</label><input asp-for="NewPassword" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">Xác nhận</label><input asp-for="ConfirmPassword" class="form-control" /></div>
        <button class="btn btn-primary">Cập nhật</button>
    </form>
</div>
