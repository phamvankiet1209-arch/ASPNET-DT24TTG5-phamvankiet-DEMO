@model ProfileViewModel
@{ ViewData["Title"] = "Hồ sơ cá nhân"; }
<div class="container py-5">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card-lux p-4 text-center">
                <img class="avatar-lg mb-3" src="@(Model.Avatar ?? "/images/users/avatar-default.jpg")" alt="avatar" />
                <h4>@Model.FullName</h4>
                <p class="text-muted mb-0">@Model.Email</p>
            </div>
        </div>
        <div class="col-lg-8">
            <form asp-action="Profile" method="post" enctype="multipart/form-data" class="card-lux p-4">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label">Họ tên</label><input asp-for="FullName" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Email</label><input asp-for="Email" class="form-control" readonly /></div>
                    <div class="col-md-6"><label class="form-label">Điện thoại</label><input asp-for="Phone" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Ngày sinh</label><input asp-for="DateOfBirth" class="form-control" type="date" /></div>
                    <div class="col-md-6"><label class="form-label">Giới tính</label><select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()"><option value="">--</option></select></div>
                    <div class="col-md-6"><label class="form-label">CCCD/Passport</label><input asp-for="IdentityNumber" class="form-control" /></div>
                    <div class="col-12"><label class="form-label">Địa chỉ</label><input asp-for="Address" class="form-control" /></div>
                    <div class="col-12"><label class="form-label">Avatar</label><input asp-for="AvatarFile" type="file" class="form-control" /></div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-primary">Lưu thay đổi</button>
                    <a class="btn btn-outline-secondary" asp-action="ChangePassword">Đổi mật khẩu</a>
                </div>
            </form>
        </div>
    </div>
</div>
