@model ResetPasswordViewModel
@{ ViewData["Title"] = "Đặt lại mật khẩu"; }
<div class="container py-5">
    <form asp-action="ResetPassword" method="post" class="card-lux p-4 mx-auto" style="max-width:520px">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Email" /><input type="hidden" asp-for="Token" />
        <h3>Đặt lại mật khẩu</h3>
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3"><label class="form-label">Mật khẩu mới</label><input asp-for="Password" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">Xác nhận</label><input asp-for="ConfirmPassword" class="form-control" /></div>
        <button class="btn btn-primary">Cập nhật</button>
    </form>
</div>
