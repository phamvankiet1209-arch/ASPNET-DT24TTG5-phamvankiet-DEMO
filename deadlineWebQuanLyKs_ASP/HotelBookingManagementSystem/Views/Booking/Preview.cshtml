@model BookingFormViewModel
@{
    ViewData["Title"] = "Xác nhận đặt phòng";
    var room = (Room)ViewBag.Room;
    var price = (PriceBreakdown)ViewBag.Price;
    var selected = ViewBag.SelectedServices as List<HotelService> ?? new List<HotelService>();
}
<div class="container py-4">
    <h2>Xác nhận thông tin</h2>
    <div class="row g-4 mt-1">
        <div class="col-lg-7">
            <div class="card-lux p-4">
                <p><strong>Khách:</strong> @Model.GuestName · @Model.GuestEmail · @Model.GuestPhone</p>
                <p><strong>Phòng:</strong> @room.Name (@room.Hotel.Name)</p>
                <p><strong>Thời gian:</strong> @DateHelper.ToVnDate(Model.CheckInDate) → @DateHelper.ToVnDate(Model.CheckOutDate) (@price.Nights đêm)</p>
                <p><strong>Khách:</strong> @Model.Adults người lớn, @Model.Children trẻ em</p>
                @if (selected.Any()) { <p><strong>Dịch vụ:</strong> @string.Join(", ", selected.Select(s => s.Name))</p> }
                @if (!string.IsNullOrEmpty(price.VoucherCode)) { <p><strong>Voucher:</strong> @price.VoucherCode</p> }
                <form asp-action="Confirm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RoomId" />
                    <input type="hidden" asp-for="GuestName" /><input type="hidden" asp-for="GuestEmail" />
                    <input type="hidden" asp-for="GuestPhone" /><input type="hidden" asp-for="GuestIdentityNumber" />
                    <input type="hidden" asp-for="CheckInDate" /><input type="hidden" asp-for="CheckOutDate" />
                    <input type="hidden" asp-for="Adults" /><input type="hidden" asp-for="Children" /><input type="hidden" asp-for="NumberOfRooms" />
                    <input type="hidden" asp-for="SpecialRequest" /><input type="hidden" asp-for="Note" /><input type="hidden" asp-for="VoucherCode" />
                    @foreach (var id in Model.ServiceIds) { <input type="hidden" name="ServiceIds" value="@id" /> }
                    <a class="btn btn-outline-secondary" asp-action="Create" asp-route-roomId="@Model.RoomId">Quay lại</a>
                    <button class="btn btn-primary">Xác nhận đặt phòng</button>
                </form>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card-lux p-4">
                <div>Tiền phòng: @CurrencyHelper.ToVnd(price.Subtotal)</div>
                <div>Phụ phí: @CurrencyHelper.ToVnd(price.ExtraFee)</div>
                <div>Dịch vụ: @CurrencyHelper.ToVnd(price.ServiceAmount)</div>
                <div>Giảm giá: @CurrencyHelper.ToVnd(price.DiscountAmount)</div>
                <div>Thuế: @CurrencyHelper.ToVnd(price.TaxAmount)</div>
                <h3 class="mt-3">Tổng thanh toán @CurrencyHelper.ToVnd(price.TotalAmount)</h3>
            </div>
        </div>
    </div>
</div>
