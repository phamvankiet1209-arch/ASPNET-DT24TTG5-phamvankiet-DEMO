@model BookingFormViewModel
@{
    ViewData["Title"] = "Đặt phòng";
    var room = (Room)ViewBag.Room;
    var price = (PriceBreakdown)ViewBag.Price;
    var services = (List<HotelService>)ViewBag.Services;
}
<div class="container py-4">
    <h2 class="mb-4">Đặt phòng</h2>
    <div class="row g-4">
        <div class="col-lg-7">
            <form asp-action="Preview" method="post" class="card-lux p-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RoomId" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label">Người đặt</label><input asp-for="GuestName" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Email</label><input asp-for="GuestEmail" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Điện thoại</label><input asp-for="GuestPhone" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">CCCD/Passport</label><input asp-for="GuestIdentityNumber" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Nhận phòng</label><input asp-for="CheckInDate" type="date" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Trả phòng</label><input asp-for="CheckOutDate" type="date" class="form-control" /></div>
                    <div class="col-md-4"><label class="form-label">Người lớn</label><input asp-for="Adults" type="number" min="1" class="form-control" /></div>
                    <div class="col-md-4"><label class="form-label">Trẻ em</label><input asp-for="Children" type="number" min="0" class="form-control" /></div>
                    <div class="col-md-4"><label class="form-label">Số phòng</label><input asp-for="NumberOfRooms" type="number" min="1" class="form-control" /></div>
                    <div class="col-12"><label class="form-label">Yêu cầu đặc biệt</label><textarea asp-for="SpecialRequest" class="form-control"></textarea></div>
                    <div class="col-12"><label class="form-label">Ghi chú</label><textarea asp-for="Note" class="form-control"></textarea></div>
                    <div class="col-12">
                        <label class="form-label">Dịch vụ thêm</label>
                        @foreach (var s in services)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="ServiceIds" value="@s.ServiceId" checked="@Model.ServiceIds.Contains(s.ServiceId)" />
                                <label class="form-check-label">@s.Name - @CurrencyHelper.ToVnd(s.Price)/@s.Unit</label>
                            </div>
                        }
                    </div>
                    <div class="col-md-8"><label class="form-label">Mã giảm giá</label><input asp-for="VoucherCode" class="form-control" /></div>
                    <div class="col-md-4 d-flex align-items-end"><button type="button" id="voucherBtn" class="btn btn-outline-primary w-100">Áp dụng</button></div>
                </div>
                <button class="btn btn-primary mt-4">Xem xác nhận</button>
            </form>
        </div>
        <div class="col-lg-5">
            <div class="card-lux p-4">
                <img class="rounded-4 mb-3" src="@room.Thumbnail" alt="@room.Name" />
                <h4>@room.Name</h4>
                <div class="text-muted">@room.Hotel.Name</div>
                <hr />
                <div>Số đêm: <strong>@price.Nights</strong></div>
                <div>Tiền phòng: @CurrencyHelper.ToVnd(price.Subtotal)</div>
                <div>Phụ phí: @CurrencyHelper.ToVnd(price.ExtraFee)</div>
                <div>Dịch vụ: @CurrencyHelper.ToVnd(price.ServiceAmount)</div>
                <div>Giảm giá: <span id="discountPay">@CurrencyHelper.ToVnd(price.DiscountAmount)</span></div>
                <div>Thuế 8%: @CurrencyHelper.ToVnd(price.TaxAmount)</div>
                <h4 class="mt-3">Tổng: <span id="totalPay">@CurrencyHelper.ToVnd(price.TotalAmount)</span></h4>
            </div>
        </div>
    </div>
</div>
