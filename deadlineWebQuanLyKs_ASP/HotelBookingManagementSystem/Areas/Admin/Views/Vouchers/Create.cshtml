@model Voucher
@{ ViewData["Title"] = "Voucher"; }
<form method="post" class="card p-4">
@Html.AntiForgeryToken()
<input type="hidden" asp-for="VoucherId" />
<div class="row g-3">
<div class="col-md-4"><label>Mã</label><input asp-for="Code" class="form-control" /></div>
<div class="col-md-8"><label>Tên</label><input asp-for="Name" class="form-control" /></div>
<div class="col-12"><label>Mô tả</label><input asp-for="Description" class="form-control" /></div>
<div class="col-md-4"><label>Loại</label><select asp-for="DiscountType" class="form-select" asp-items="Html.GetEnumSelectList<DiscountType>()"></select></div>
<div class="col-md-4"><label>Giá trị</label><input asp-for="DiscountValue" class="form-control" /></div>
<div class="col-md-4"><label>Đơn tối thiểu</label><input asp-for="MinimumOrder" class="form-control" /></div>
<div class="col-md-4"><label>Giảm tối đa</label><input asp-for="MaximumDiscount" class="form-control" /></div>
<div class="col-md-4"><label>Bắt đầu</label><input asp-for="StartDate" type="date" class="form-control" /></div>
<div class="col-md-4"><label>Kết thúc</label><input asp-for="EndDate" type="date" class="form-control" /></div>
<div class="col-md-4"><label>Số lượng</label><input asp-for="Quantity" class="form-control" /></div>
<div class="form-check"><input asp-for="Status" class="form-check-input" /><label class="form-check-label">Kích hoạt</label></div>
</div>
<button class="btn btn-primary mt-3">Lưu</button>
</form>
