@model HotelService
@{ ViewData["Title"] = "Dịch vụ"; }
<form method="post" class="card p-4">
@Html.AntiForgeryToken()
<input type="hidden" asp-for="ServiceId" />
<div class="mb-2"><label>Tên</label><input asp-for="Name" class="form-control" /></div>
<div class="mb-2"><label>Mô tả</label><textarea asp-for="Description" class="form-control"></textarea></div>
<div class="mb-2"><label>Giá</label><input asp-for="Price" class="form-control" /></div>
<div class="mb-2"><label>Đơn vị</label><input asp-for="Unit" class="form-control" /></div>
<div class="form-check"><input asp-for="Status" class="form-check-input" /><label class="form-check-label">Hiện</label></div>
<button class="btn btn-primary mt-3">Lưu</button>
</form>
