@model DashboardStats
@{ ViewData["Title"] = "Dashboard"; }
<div class="row g-3 mb-4">
    @{
        var cards = new (string Label, string Value)[] {
            ("Khách hàng", Model.TotalCustomers.ToString()),
            ("Khách sạn", Model.TotalHotels.ToString()),
            ("Tổng phòng", Model.TotalRooms.ToString()),
            ("Phòng trống", Model.AvailableRooms.ToString()),
            ("Đang sử dụng", Model.OccupiedRooms.ToString()),
            ("Tổng booking", Model.TotalBookings.ToString()),
            ("Booking hôm nay", Model.TodayBookings.ToString()),
            ("Đang chờ", Model.PendingBookings.ToString()),
            ("Đã xác nhận", Model.ConfirmedBookings.ToString()),
            ("Đã hủy", Model.CancelledBookings.ToString()),
            ("DT hôm nay", CurrencyHelper.ToVnd(Model.TodayRevenue)),
            ("DT tháng", CurrencyHelper.ToVnd(Model.MonthRevenue)),
            ("Tổng doanh thu", CurrencyHelper.ToVnd(Model.TotalRevenue))
        };
    }
    @foreach (var c in cards)
    {
        <div class="col-6 col-md-4 col-xl-3"><div class="card stat-card p-3"><div class="text-muted small">@c.Label</div><div class="fw-bold fs-5">@c.Value</div></div></div>
    }
</div>
<div class="row g-4">
    <div class="col-lg-8"><div class="card p-3"><canvas id="revChart"></canvas></div></div>
    <div class="col-lg-4"><div class="card p-3"><canvas id="statusChart"></canvas></div></div>
    <div class="col-lg-6"><div class="card p-3"><h5>Phòng đặt nhiều</h5><ul>@foreach (var x in Model.TopRooms){<li>@x.Name - @x.Count</li>}</ul></div></div>
    <div class="col-lg-6"><div class="card p-3"><h5>Khách đặt nhiều</h5><ul>@foreach (var x in Model.TopCustomers){<li>@x.Name - @x.Count</li>}</ul></div></div>
</div>
@section Scripts {
<script>
const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthLabels));
new Chart(document.getElementById('revChart'), { type:'line', data:{ labels, datasets:[
    {label:'Doanh thu', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthRevenueData)), borderColor:'#2563EB', tension:.3},
    {label:'Booking', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthBookingData)), borderColor:'#F59E0B', yAxisID:'y1'}
]}, options:{ scales:{ y:{beginAtZero:true}, y1:{position:'right', beginAtZero:true, grid:{drawOnChartArea:false}}}}});
new Chart(document.getElementById('statusChart'), { type:'doughnut', data:{ labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusLabels)), datasets:[{data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusData)), backgroundColor:['#f59e0b','#38bdf8','#2563eb','#22c55e','#ef4444','#94a3b8']}]}});
</script>
}
