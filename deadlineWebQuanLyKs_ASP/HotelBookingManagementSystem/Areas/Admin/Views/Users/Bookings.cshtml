@model List<Booking>
@{ ViewData["Title"] = "Lịch sử booking"; var user = (ApplicationUser)ViewBag.User; }
<h4>@user.FullName</h4>
<table class="table bg-white"><thead><tr><th>Mã</th><th>Phòng</th><th>Ngày</th><th>Tổng</th><th>TT</th></tr></thead>
<tbody>
@foreach (var b in Model) {
<tr><td>@b.BookingCode</td><td>@b.Room.Name</td><td>@DateHelper.ToVnDate(b.CheckInDate)</td><td>@CurrencyHelper.ToVnd(b.TotalAmount)</td><td>@EnumDisplayHelper.BookingStatus(b.BookingStatus)</td></tr>
}
</tbody></table>
