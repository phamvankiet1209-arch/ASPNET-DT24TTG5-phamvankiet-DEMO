@model Booking
@{ ViewData["Title"] = "Chi tiết booking"; }
<div class="card p-4 mb-3">
<h4>@Model.BookingCode</h4>
<p>@Model.GuestName · @Model.GuestEmail · @Model.GuestPhone · CCCD @Model.GuestIdentityNumber</p>
<p>@Model.Room.Name - @Model.Hotel.Name</p>
<p>@DateHelper.ToVnDate(Model.CheckInDate) → @DateHelper.ToVnDate(Model.CheckOutDate)</p>
<p>Thanh toán: @EnumDisplayHelper.PaymentStatus(Model.PaymentStatus) · Tổng @CurrencyHelper.ToVnd(Model.TotalAmount)</p>
<p>Còn thiếu: @(Model.PaymentStatus==PaymentStatus.Paid ? "0 ₫" : CurrencyHelper.ToVnd(Model.TotalAmount))</p>
</div>
<div class="d-flex gap-2">
<form asp-action="Confirm" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.BookingId" /><button class="btn btn-info">Xác nhận</button></form>
<form asp-action="DoCheckIn" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.BookingId" /><button class="btn btn-primary">Check-in</button></form>
<form asp-action="DoCheckOut" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.BookingId" /><button class="btn btn-success">Check-out</button></form>
<form asp-action="Cancel" method="post" class="d-flex gap-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.BookingId" /><input name="reason" class="form-control" placeholder="Lý do" /><button class="btn btn-outline-danger">Hủy</button></form>
</div>
